<Project Sdk="Microsoft.NET.Sdk">
  <!-- Radiance Music for Windows, the native beta (issue #45): C# + WinUI 3 over the Rust engine
       (radiance_ffi.dll and its C# binding, made by windows\build.ps1). Unpackaged and self-contained,
       as the Radiance POS app (radiance-pos-apps). Windows 10 1809 or newer. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>RadianceMusic</RootNamespace>
    <AssemblyName>RadianceMusicBeta</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\..\packaging\windows\radiance-music.ico</ApplicationIcon>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Program.cs starts the app itself, so the self-check and the screenshots run their own way -->
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <Version>0.8.0-beta.10</Version>
    <Product>Radiance Music (beta)</Product>
    <Company>Radiance Innovation Centers</Company>
    <Copyright>Radiance Innovation Centers. GPL-3.0-or-later.</Copyright>
    <Description>Radiance Music (beta)</Description>
    <!-- the generated binding (Native\radiance_ffi.cs) isn't written for nullable checks -->
    <NoWarn>$(NoWarn);CS8600;CS8601;CS8602;CS8603;CS8604;CS8618;CS8625;CS0168;CS0219</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.6.5" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2957" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="..\..\packaging\windows\radiance-music.ico" Link="radiance-music.ico" CopyToOutputDirectory="PreserveNewest" />
    <!-- the listening party's reactions (stage 4c-2): the Linux app's pictures, beside the app in icons\ -->
    <Content Include="..\..\data\icons\rms-react-*.svg" Link="icons\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
