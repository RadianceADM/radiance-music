<?xml version="1.0" encoding="utf-8"?>
<!-- Home: the greeting and your mix, then Made for you, Recently played, Your liked songs (the same
     sections and words as the GTK app), in Windows' own look. Albums, Artists, Genres: stage 2. -->
<Page
    x:Class="RadianceMusic.Pages.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    NavigationCacheMode="Required">
    <!-- (as Search's: the page-wide grid holds the column's width, no sideways scrolling) -->
    <ScrollViewer HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
        <Grid Padding="36,20,36,36">
        <StackPanel MaxWidth="1480" HorizontalAlignment="Stretch" Spacing="32">
            <StackPanel Spacing="6">
                <TextBlock x:Name="Greeting" Style="{StaticResource TitleLargeTextBlockStyle}" TextWrapping="WrapWholeWords" />
                <TextBlock x:Name="MixNote" Style="{StaticResource BodyTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <StackPanel x:Name="HeroButtons" Orientation="Horizontal" Spacing="8" Margin="0,12,0,0" />
            </StackPanel>
            <StackPanel x:Name="Rows" Spacing="32" />
        </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
