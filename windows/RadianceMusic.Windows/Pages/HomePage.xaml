<?xml version="1.0" encoding="utf-8"?>
<!-- Home, as the GTK app's (ui/home.rs): the hero (a greeting over your mix's colours, two drifting
     lights, its covers fanned, play), then Made for you, Recently played, Your liked songs.
     Albums, Artists and Genres come with the library pages (stage 2). -->
<Page
    x:Class="RadianceMusic.Pages.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="using:RadianceMusic.Controls"
    NavigationCacheMode="Required">
    <ScrollViewer>
        <StackPanel x:Name="Column" MaxWidth="1600" Padding="24,6,24,32" Spacing="18">
            <Grid x:Name="Hero" CornerRadius="26" MinHeight="230" Background="{StaticResource b1}">
                <Border x:Name="Wash" CornerRadius="26" />
                <c:Lights />
                <Border CornerRadius="26">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                            <GradientStop Color="#D9000000" Offset="0" />
                            <GradientStop Color="#80000000" Offset="0.45" />
                            <GradientStop Color="#0D000000" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
                <Grid x:Name="HeroContent" Padding="40,34,40,34" ColumnSpacing="24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Spacing="10">
                        <TextBlock x:Name="Greeting" Style="{StaticResource HeroTitle}" />
                        <TextBlock x:Name="MixNote" Style="{StaticResource HeroSub}" MaxWidth="460" HorizontalAlignment="Left" />
                        <StackPanel x:Name="HeroButtons" Orientation="Horizontal" Spacing="10" Margin="0,10,0,0" />
                    </StackPanel>
                    <Grid x:Name="Fan" Grid.Column="1" Width="300" Height="170" VerticalAlignment="Center" />
                </Grid>
            </Grid>
            <StackPanel x:Name="Rows" Spacing="18" />
        </StackPanel>
    </ScrollViewer>
</Page>
