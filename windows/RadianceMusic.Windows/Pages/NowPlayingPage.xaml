<?xml version="1.0" encoding="utf-8"?>
<!-- Now Playing: the song's art moving behind (the compositor's), the cover, title, names and
     quality, and the lyric lines beside it (the sung one lit, kept in the middle). Windows' own
     type and controls; dark over the art. Under 1060 px the lyrics make room. -->
<Page
    x:Class="RadianceMusic.Pages.NowPlayingPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="using:RadianceMusic.Controls"
    NavigationCacheMode="Required">
    <Grid x:Name="Root">
        <c:Backdrop x:Name="Back" />
        <Border x:Name="Scrim" Visibility="Collapsed">
            <Border.Background>
                <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                    <GradientStop Color="#59000000" Offset="0" />
                    <GradientStop Color="#99000000" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
        </Border>
        <Grid x:Name="Body" Padding="36,24,36,24" ColumnSpacing="48">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel x:Name="Left" VerticalAlignment="Center" Spacing="8" Width="340">
                <Border x:Name="Cover" Width="340" Height="340" CornerRadius="8" Margin="0,0,0,8"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" />
                <TextBlock x:Name="SongTitle" Style="{StaticResource TitleTextBlockStyle}" Text="Nothing playing"
                           TextWrapping="WrapWholeWords" MaxLines="2" TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="Byline" Style="{StaticResource BodyTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                <Border x:Name="Quality" HorizontalAlignment="Left" CornerRadius="4" Padding="8,2" Margin="0,4,0,0" Visibility="Collapsed"
                        Background="{ThemeResource ControlFillColorSecondaryBrush}">
                    <TextBlock x:Name="QualityText" Style="{StaticResource CaptionTextBlockStyle}" />
                </Border>
            </StackPanel>
            <Grid x:Name="Right" Grid.Column="1">
                <ScrollViewer x:Name="LyricsScroll" VerticalScrollBarVisibility="Hidden" HorizontalScrollMode="Disabled">
                    <StackPanel x:Name="Lines" />
                </ScrollViewer>
                <TextBlock x:Name="LyricsNote" Style="{StaticResource BodyTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
            </Grid>
        </Grid>
    </Grid>
</Page>
