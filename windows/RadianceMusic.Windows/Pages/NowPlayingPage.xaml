<?xml version="1.0" encoding="utf-8"?>
<!-- Now Playing: the song's art moving behind (the compositor's), the cover, title, names and
     quality, and the lyric lines beside it (the sung one lit, kept in the middle). Windows' own
     type and controls; dark over the art. Under 1060 px the lyrics make room. -->
<Page
    x:Class="RadianceMusic.Pages.NowPlayingPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="using:RadianceMusic.Controls"
    NavigationCacheMode="Required">
    <Grid x:Name="Root">
        <c:Backdrop x:Name="Back" />
        <Border x:Name="Scrim" Visibility="Collapsed">
            <Border.Background>
                <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                    <GradientStop Color="#59000000" Offset="0" />
                    <GradientStop Color="#99000000" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
        </Border>
        <Grid x:Name="Body" Padding="36,24,36,24" ColumnSpacing="48">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel x:Name="Left" VerticalAlignment="Center" Spacing="8" Width="340">
                <!-- the cover, or the music video on the compositor (a SwapChainPanel the engine's
                     d3d12swapchainsink draws into), with its buttons on top -->
                <Grid x:Name="Art" Width="340" Height="340" Margin="0,0,0,8">
                    <Border x:Name="Cover" CornerRadius="8"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" />
                    <SwapChainPanel x:Name="VideoPanel" Visibility="Collapsed" />
                    <Border x:Name="VideoTaps" Background="Transparent" Visibility="Collapsed" DoubleTapped="OnVideoDoubleTapped" />
                    <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="10">
                        <Button x:Name="FullscreenButton" Visibility="Collapsed" Click="OnFullscreen" Padding="9" CornerRadius="18"
                                Background="#99000000" Foreground="White" BorderThickness="0">
                            <FontIcon x:Name="FullscreenIcon" Glyph="&#xE740;" FontSize="14" />
                        </Button>
                        <Button x:Name="VideoButton" Visibility="Collapsed" Click="OnVideo" Padding="9" CornerRadius="18"
                                Background="#99000000" Foreground="White" BorderThickness="0">
                            <FontIcon x:Name="VideoIcon" Glyph="&#xE714;" FontSize="14" />
                        </Button>
                    </StackPanel>
                </Grid>
                <TextBlock x:Name="SongTitle" Style="{StaticResource TitleTextBlockStyle}" Text="Nothing playing"
                           TextWrapping="WrapWholeWords" MaxLines="2" TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="Byline" Style="{StaticResource BodyTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                <Border x:Name="Quality" HorizontalAlignment="Left" CornerRadius="4" Padding="8,2" Margin="0,4,0,0" Visibility="Collapsed"
                        Background="{ThemeResource ControlFillColorSecondaryBrush}">
                    <TextBlock x:Name="QualityText" Style="{StaticResource CaptionTextBlockStyle}" />
                </Border>
            </StackPanel>
            <Grid x:Name="Right" Grid.Column="1">
                <ScrollViewer x:Name="LyricsScroll" VerticalScrollBarVisibility="Hidden" HorizontalScrollMode="Disabled">
                    <StackPanel x:Name="Lines" />
                </ScrollViewer>
                <TextBlock x:Name="LyricsNote" Style="{StaticResource BodyTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
            </Grid>
        </Grid>
    </Grid>
</Page>
