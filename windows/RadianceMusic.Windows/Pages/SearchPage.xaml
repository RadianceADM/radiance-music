<?xml version="1.0" encoding="utf-8"?>
<!-- Search: the box; before typing, the GTK app's browse picks; then your liked songs that match,
     and YouTube Music, each with the GTK app's note. Windows' own look. -->
<Page
    x:Class="RadianceMusic.Pages.SearchPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    NavigationCacheMode="Required">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel Padding="36,20,36,12" Spacing="12">
            <TextBlock Text="Search" Style="{StaticResource TitleLargeTextBlockStyle}" />
            <AutoSuggestBox x:Name="Box" PlaceholderText="Search any song or artist" QueryIcon="Find" MaxWidth="1240"
                            HorizontalAlignment="Stretch" TextChanged="OnTyped" QuerySubmitted="OnSubmit" />
        </StackPanel>
        <!-- one column with the box, as the Linux app's (a 1240 clamp): the page-wide grid holds its width,
             so the lists never shrink to their longest row and drift as the results change -->
        <ScrollViewer Grid.Row="1" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
            <Grid Padding="36,8,36,36">
            <StackPanel MaxWidth="1240" HorizontalAlignment="Stretch" Spacing="24">
                <StackPanel x:Name="BrowseArea" Spacing="12">
                    <TextBlock Text="Browse" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <ItemsRepeater x:Name="Tiles">
                        <ItemsRepeater.Layout>
                            <UniformGridLayout MinItemWidth="200" MinItemHeight="64" MinColumnSpacing="8" MinRowSpacing="8" ItemsStretch="Fill" />
                        </ItemsRepeater.Layout>
                    </ItemsRepeater>
                </StackPanel>
                <StackPanel x:Name="ResultsArea" Spacing="24" Visibility="Collapsed">
                    <StackPanel x:Name="MineSection" Spacing="4" Visibility="Collapsed">
                        <TextBlock Text="Liked Songs" Style="{StaticResource SubtitleTextBlockStyle}" />
                        <TextBlock x:Name="MineNote" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <ListView x:Name="MineList" SelectionMode="None" IsItemClickEnabled="True" ItemClick="OnPlay" Tag="Mine" Margin="-16,4,-16,0" />
                    </StackPanel>
                    <StackPanel Spacing="4">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock Text="YouTube Music" Style="{StaticResource SubtitleTextBlockStyle}" />
                            <ProgressRing x:Name="SongsSpin" Width="16" Height="16" IsActive="False" />
                        </StackPanel>
                        <TextBlock x:Name="SongsNote" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <ListView x:Name="SongsList" SelectionMode="None" IsItemClickEnabled="True" ItemClick="OnPlay" Tag="Songs" Margin="-16,4,-16,0" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>
