<?xml version="1.0" encoding="utf-8"?>
<!-- The window, as Windows 11's own apps: Mica behind, the app's title in the title bar,
     NavigationView's pages on the left (it folds itself away when the window is narrow), the
     player bar along the bottom. -->
<Window
    x:Class="RadianceMusic.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Radiance Music (beta)">
    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid x:Name="AppTitleBar" Height="48" Padding="16,0,0,0">
            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <Image x:Name="TitleIcon" Width="16" Height="16" />
                <TextBlock Text="Radiance Music" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" />
                <TextBlock Text="Beta" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
        </Grid>
        <NavigationView x:Name="Nav" Grid.Row="1" IsSettingsVisible="False" IsBackButtonVisible="Collapsed"
                        PaneDisplayMode="Auto" OpenPaneLength="240" IsTitleBarAutoPaddingEnabled="False"
                        SelectionChanged="OnNav">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="Home" Tag="home">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE80F;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Search" Tag="search">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE721;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Now Playing" Tag="playing">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE8D6;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItemHeader Content="Library" />
                <NavigationViewItem Content="Liked Songs" Tag="liked">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xEB52;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="History" Tag="history">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE81C;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Albums" Tag="albums">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE93C;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Artists" Tag="artists">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE77B;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Genres" Tag="genres">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE8FD;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItemHeader x:Name="PlaylistsHeader" Content="Playlists" />
            </NavigationView.MenuItems>
            <Grid>
                <Frame x:Name="Pages" />
                <InfoBar x:Name="Toast" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="20,0,20,20"
                         MaxWidth="720" IsOpen="False" Severity="Informational" IsClosable="True" />
                <InfoBar x:Name="Notice" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="20,0,20,20"
                         MaxWidth="720" IsOpen="False" Severity="Warning" IsClosable="True">
                    <InfoBar.ActionButton>
                        <Button Click="OnTryAgain">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE72C;" FontSize="14" />
                                <TextBlock Text="Try Again" />
                            </StackPanel>
                        </Button>
                    </InfoBar.ActionButton>
                </InfoBar>
            </Grid>
        </NavigationView>
        <ContentControl x:Name="BarHost" Grid.Row="2" HorizontalContentAlignment="Stretch" />
    </Grid>
</Window>
