<?xml version="1.0" encoding="utf-8"?>
<!-- The shell, as the GTK app's (ui/home.rs shell): a sidebar of pages, the page on a rounded card,
     the player bar along the bottom. Under 860 px wide the sidebar slides over from its button. -->
<Window
    x:Class="RadianceMusic.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Radiance Music (beta)">
    <Grid x:Name="Root" Background="{StaticResource ShellBrush}" RequestedTheme="Dark" SizeChanged="OnSize">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <SplitView x:Name="Split" DisplayMode="Inline" IsPaneOpen="True" OpenPaneLength="232"
                   PaneBackground="{StaticResource ShellBrush}">
            <SplitView.Pane>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="48" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel x:Name="Brand" Orientation="Horizontal" Spacing="10" Margin="20,0,0,0" VerticalAlignment="Center">
                        <Image x:Name="BrandIcon" Width="20" Height="20" />
                        <TextBlock Text="Radiance Music" FontWeight="ExtraBold" FontSize="15" VerticalAlignment="Center" />
                    </StackPanel>
                    <ListView x:Name="Nav" Grid.Row="1" SelectionMode="Single" SelectionChanged="OnNav" Padding="8,4,8,4">
                        <ListViewItem Tag="home">
                            <StackPanel Orientation="Horizontal" Spacing="14">
                                <FontIcon Glyph="&#xE80F;" FontSize="16" />
                                <TextBlock Text="Home" />
                            </StackPanel>
                        </ListViewItem>
                        <ListViewItem Tag="search">
                            <StackPanel Orientation="Horizontal" Spacing="14">
                                <FontIcon Glyph="&#xE721;" FontSize="16" />
                                <TextBlock Text="Search" />
                            </StackPanel>
                        </ListViewItem>
                        <ListViewItem Tag="playing">
                            <StackPanel Orientation="Horizontal" Spacing="14">
                                <FontIcon Glyph="&#xE8D6;" FontSize="16" />
                                <TextBlock Text="Now Playing" />
                            </StackPanel>
                        </ListViewItem>
                    </ListView>
                </Grid>
            </SplitView.Pane>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="48" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button x:Name="ShowNav" Visibility="Collapsed" Click="OnShowNav" Margin="8,0,0,0"
                        Background="Transparent" BorderThickness="0" ToolTipService.ToolTip="Pages">
                    <FontIcon Glyph="&#xE700;" FontSize="16" />
                </Button>
                <!-- the window's own title bar: drag it here (its buttons are Windows') -->
                <Grid x:Name="TitleArea" Grid.Column="1" Background="Transparent" />
                <Border Grid.Row="1" Grid.ColumnSpan="2" Background="{StaticResource PageBrush}"
                        CornerRadius="{StaticResource PageCornerRadius}" Margin="0,0,10,8">
                    <Frame x:Name="Pages" />
                </Border>
                <InfoBar x:Name="Notice" Grid.Row="1" Grid.ColumnSpan="2" VerticalAlignment="Bottom" HorizontalAlignment="Center"
                         Margin="20,0,20,24" MaxWidth="720" IsOpen="False" Severity="Informational" IsClosable="True">
                    <InfoBar.ActionButton>
                        <Button Click="OnTryAgain">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE72C;" FontSize="14" />
                                <TextBlock Text="Try Again" />
                            </StackPanel>
                        </Button>
                    </InfoBar.ActionButton>
                </InfoBar>
            </Grid>
        </SplitView>
        <ContentControl x:Name="BarHost" Grid.Row="1" HorizontalContentAlignment="Stretch" />
    </Grid>
</Window>
