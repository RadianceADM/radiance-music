<?xml version="1.0" encoding="utf-8"?>
<!-- The few styles of the app's own; everything else is WinUI's (TitleLargeTextBlockStyle,
     CardBackgroundFillColorDefaultBrush, AccentButtonStyle, …), as Windows' built-in apps. -->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- a lyric line on Now Playing (over the art: the page is dark there) -->
    <Style x:Key="Lyric" TargetType="TextBlock" BasedOn="{StaticResource TitleTextBlockStyle}">
        <Setter Property="Opacity" Value="0.4" />
        <Setter Property="TextWrapping" Value="WrapWholeWords" />
        <Setter Property="Padding" Value="0,8" />
    </Style>
    <Style x:Key="LyricPlain" TargetType="TextBlock" BasedOn="{StaticResource BodyLargeTextBlockStyle}">
        <Setter Property="TextWrapping" Value="WrapWholeWords" />
    </Style>
</ResourceDictionary>
