<?xml version="1.0" encoding="utf-8"?>
<!-- Radiance's dark "Stone" look (the GTK app: ui.rs CSS, ui/home.rs STONE and CSS), on WinUI's own
     controls. Rounded everywhere (nothing sharp); every button carries an icon. -->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="ShellColor">#0C0A09</Color>
    <Color x:Key="PageColor">#1C1917</Color>
    <Color x:Key="FgColor">#F5F5F4</Color>
    <Color x:Key="CardColor">#0DFFFFFF</Color>
    <Color x:Key="PopoverColor">#292524</Color>
    <Color x:Key="AccentColorRadiance">#F38A35</Color>
    <Color x:Key="AccentFgColor">#1A0F05</Color>
    <Color x:Key="AccentTextColor">#FFAE63</Color>
    <Color x:Key="LikedColor">#E5364F</Color>
    <SolidColorBrush x:Key="ShellBrush" Color="{StaticResource ShellColor}" />
    <SolidColorBrush x:Key="PageBrush" Color="{StaticResource PageColor}" />
    <SolidColorBrush x:Key="FgBrush" Color="{StaticResource FgColor}" />
    <SolidColorBrush x:Key="DimBrush" Color="#9EF5F5F4" />
    <SolidColorBrush x:Key="CardBrush" Color="{StaticResource CardColor}" />
    <SolidColorBrush x:Key="PopoverBrush" Color="{StaticResource PopoverColor}" />
    <SolidColorBrush x:Key="AccentBrushRadiance" Color="{StaticResource AccentColorRadiance}" />
    <SolidColorBrush x:Key="AccentFgBrush" Color="{StaticResource AccentFgColor}" />
    <SolidColorBrush x:Key="AccentTextBrush" Color="{StaticResource AccentTextColor}" />
    <SolidColorBrush x:Key="LosslessBgBrush" Color="#4057E389" />
    <SolidColorBrush x:Key="LosslessFgBrush" Color="#8FF0A4" />
    <!-- WinUI's own accent (the play button, sliders, selection) in Radiance's orange -->
    <SolidColorBrush x:Key="AccentButtonBackground" Color="{StaticResource AccentColorRadiance}" />
    <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="#FFA055" />
    <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="#D9762A" />
    <SolidColorBrush x:Key="AccentButtonForeground" Color="{StaticResource AccentFgColor}" />
    <SolidColorBrush x:Key="AccentButtonForegroundPointerOver" Color="{StaticResource AccentFgColor}" />
    <SolidColorBrush x:Key="AccentButtonForegroundPressed" Color="{StaticResource AccentFgColor}" />
    <SolidColorBrush x:Key="SliderTrackValueFill" Color="{StaticResource AccentColorRadiance}" />
    <SolidColorBrush x:Key="SliderTrackValueFillPointerOver" Color="#FFA055" />
    <SolidColorBrush x:Key="SliderTrackValueFillPressed" Color="#D9762A" />
    <SolidColorBrush x:Key="SliderThumbBackground" Color="{StaticResource AccentColorRadiance}" />
    <CornerRadius x:Key="ControlCornerRadius">12</CornerRadius>
    <CornerRadius x:Key="OverlayCornerRadius">16</CornerRadius>
    <CornerRadius x:Key="PageCornerRadius">14</CornerRadius>

    <Style x:Key="HeroTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="36" />
        <Setter Property="FontWeight" Value="ExtraBold" />
        <Setter Property="CharacterSpacing" Value="-42" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="TextWrapping" Value="WrapWholeWords" />
    </Style>
    <Style x:Key="HeroSub" TargetType="TextBlock">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="Foreground" Value="#CCFFFFFF" />
        <Setter Property="TextWrapping" Value="WrapWholeWords" />
    </Style>
    <Style x:Key="SectionTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{StaticResource FgBrush}" />
    </Style>
    <Style x:Key="PageTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="28" />
        <Setter Property="FontWeight" Value="ExtraBold" />
        <Setter Property="Foreground" Value="{StaticResource FgBrush}" />
    </Style>
    <Style x:Key="Note" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource DimBrush}" />
        <Setter Property="TextWrapping" Value="WrapWholeWords" />
    </Style>
    <Style x:Key="NpTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="24" />
        <Setter Property="FontWeight" Value="ExtraBold" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="MaxLines" Value="2" />
        <Setter Property="TextWrapping" Value="WrapWholeWords" />
    </Style>
    <Style x:Key="Lyric" TargetType="TextBlock">
        <Setter Property="FontSize" Value="29" />
        <Setter Property="FontWeight" Value="ExtraBold" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="Opacity" Value="0.34" />
        <Setter Property="TextWrapping" Value="WrapWholeWords" />
        <Setter Property="Padding" Value="18,10" />
    </Style>
    <Style x:Key="LyricPlain" TargetType="TextBlock">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="TextWrapping" Value="WrapWholeWords" />
        <Setter Property="Padding" Value="16,12" />
    </Style>
    <Style x:Key="CardTitle" TargetType="TextBlock">
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{StaticResource FgBrush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="MaxLines" Value="1" />
    </Style>
    <Style x:Key="CardSub" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource FgBrush}" />
        <Setter Property="Opacity" Value="0.62" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="MaxLines" Value="1" />
    </Style>

    <!-- the browse tiles' gradients (home.rs CSS .b0 … .b5, 135°; tile i uses b(i mod 6)) -->
    <LinearGradientBrush x:Key="b0" StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#F38A35" Offset="0" /><GradientStop Color="#B8452A" Offset="1" /></LinearGradientBrush>
    <LinearGradientBrush x:Key="b1" StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#9B2D3F" Offset="0" /><GradientStop Color="#3A1016" Offset="1" /></LinearGradientBrush>
    <LinearGradientBrush x:Key="b2" StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#C2367A" Offset="0" /><GradientStop Color="#5B1A5E" Offset="1" /></LinearGradientBrush>
    <LinearGradientBrush x:Key="b3" StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#17907E" Offset="0" /><GradientStop Color="#0C3B4A" Offset="1" /></LinearGradientBrush>
    <LinearGradientBrush x:Key="b4" StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#7A4FD6" Offset="0" /><GradientStop Color="#2B1B5C" Offset="1" /></LinearGradientBrush>
    <LinearGradientBrush x:Key="b5" StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#FFAE63" Offset="0" /><GradientStop Color="#C46A1D" Offset="1" /></LinearGradientBrush>
</ResourceDictionary>
